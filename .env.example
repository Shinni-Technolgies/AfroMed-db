# =============================================================
# AfroMed Environment Configuration — EXAMPLE
# Copy this file to .env and fill in real values.
# =============================================================

# ------------------------------------------------------------------
# PostgreSQL — individual connection components
# The entrypoint scripts construct the URI from these at runtime.
# Format: postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
# ------------------------------------------------------------------
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_NAME=YOUR_DB_NAME

# ------------------------------------------------------------------
# pgAdmin
# ------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_SERVER_JSON_FILE=/tmp/servers.json

# pgAdmin server display labels (used when generating servers.json)
PGADMIN_SERVER_NAME=AfroMed DB
PGADMIN_SERVER_GROUP=Servers
PGADMIN_SERVER_SSL_MODE=prefer
